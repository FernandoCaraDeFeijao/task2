<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.fernando.myapplication.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/authentication"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <navigation
        android:id="@+id/authentication"
        app:startDestination="@id/loginFragment">

        <fragment
            android:id="@+id/recoverAccountFragment"
            android:name="com.fernando.myapplication.ui.auth.RecoverAccountFragment"
            android:label="Recover"
            tools:layout="@layout/fragment_recover_account" />

        <fragment
            android:id="@+id/loginFragment"
            android:name="com.fernando.myapplication.ui.auth.LoginFragment"
            android:label="Login"
            tools:layout="@layout/fragment_login">

            <action
                android:id="@+id/action_loginFragment_to_registerFragment"
                app:destination="@id/registerFragment" />

            <action
                android:id="@+id/action_loginFragment_to_recoverAccountFragment"
                app:destination="@id/recoverAccountFragment" />
        </fragment>

        <fragment
            android:id="@+id/registerFragment"
            android:name="com.fernando.myapplication.ui.auth.RegisterFragment"
            android:label="Register"
            tools:layout="@layout/fragment_register" />

        <action
            android:id="@+id/action_global_homeFragment"
            app:destination="@id/homeFragment" />

    </navigation>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.fernando.myapplication.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_formTaskFragment"
            app:destination="@id/formTaskFragment" />
    </fragment>
    <fragment
        android:id="@+id/formTaskFragment"
        android:name="com.fernando.myapplication.ui.FormTaskFragment"
        android:label="fragment_form_task"
        tools:layout="@layout/fragment_form_task" />

</navigation>